# Local dev: copy to .env.development.local (read by `next dev` only).
# Production runs on Cloudflare Workers: set secrets with `npx wrangler secret put <NAME>`
# and plain values in the Worker's Variables. Never put secrets in .env / .env.local:
# OpenNext inlines .env files into the Worker bundle (the deploy script refuses to ship them).

# --- Hoan AI chat (/api/chat, see src/ai/model.ts) ---
# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. OpenRouter model id; defaults to anthropic/claude-haiku-5.5.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional. Max tokens per answer; defaults to 32000. Claude Haiku 5.5 allows up to 128000,
# but OpenRouter reserves credits for the whole cap on every request, so a cap your balance
# can't cover fails with 402. Vietnamese needs roughly 2–3x the tokens of English.
AI_MAX_OUTPUT_TOKENS=32000

# Optional. Site-wide cap on chat requests per day (see src/app/api/chat/route.ts); defaults to 1000.
AI_DAILY_REQUEST_LIMIT=1000
