# Copy to .env.local for local dev, or set these in your hosting provider's
# environment variables (e.g. Vercel → Project Settings → Environment Variables).

# --- Hoan AI chat (/api/chat, see src/ai/model.ts) ---
# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. OpenRouter model id; defaults to anthropic/claude-haiku-5.5.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional. Max tokens per answer; defaults to 128000 (the Claude Haiku 5.5 maximum).
# Vietnamese needs roughly 2–3x the tokens of English; lower values cut long answers off.
AI_MAX_OUTPUT_TOKENS=128000

# Optional. Site-wide cap on chat requests per day (see src/app/api/chat/route.ts); defaults to 1000.
AI_DAILY_REQUEST_LIMIT=1000
